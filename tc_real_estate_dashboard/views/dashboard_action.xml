<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action that renders the OWL dashboard component -->
    <record id="action_tc_re_dashboard" model="ir.actions.client">
        <field name="name">Real Estate Dashboard</field>
        <field name="tag">tc_real_estate_dashboard</field>
    </record>

    <!-- Top-level app menu + entry.
         No web_icon so no image file is required; Odoo shows a default tile.
         To nest it inside the Real Estate app instead, set parent= its root
         menu (e.g. real_estate_management.<root_menu_id>) on menu_tc_re_dashboard. -->
    <menuitem id="menu_tc_re_dashboard_root"
              name="RE Dashboard"
              sequence="1"/>

    <menuitem id="menu_tc_re_dashboard"
              name="Dashboard"
              parent="menu_tc_re_dashboard_root"
              action="action_tc_re_dashboard"
              sequence="10"/>
</odoo>
