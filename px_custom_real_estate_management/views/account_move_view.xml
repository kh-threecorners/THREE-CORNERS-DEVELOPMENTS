<odoo>
    <record id="view_move_form_inherit_is_cheque" model="ir.ui.view">
        <field name="name">account.move.form.is.cheque.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[2]" position="inside">
                <field name="late_fee_percentage" invisible="move_type != 'out_invoice'"/>
                <field name="is_late_fee_applied" invisible="1"/>
                <field name="is_cheque"/>
                <field name="cheque_number" invisible="not is_cheque"/>
                <field name="customer_cheque_bank_id" invisible="not is_cheque"/>
                <field name="cheque_due_date" invisible="not is_cheque"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_filter_inherit" model="ir.ui.view">
        <field name="name">account.move.search.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="cheque_number" string="Cheque Number"/>
                <field name="sale_order_id"/>
                <field name="property_project_id"/>
                <field name="property_id"/>
                <filter string="Sale Order" name="group_by_sale_order"
                        context="{'group_by': 'sale_order_id'}"/>
                <filter string="Project" name="group_by_property_project"
                        context="{'group_by': 'property_project_id'}"/>
                <filter string="Unit" name="group_by_property"
                        context="{'group_by': 'property_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_inherit" model="ir.ui.view">
        <field name="name">account.out.invoice.list.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="cheque_number"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="property_project_id" optional="hide"/>
                <field name="property_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_real_estate_links" model="ir.ui.view">
        <field name="name">account.move.form.real.estate.links</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not sale_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sale Order</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="sale_order_id" readonly="1"
                       invisible="not sale_order_id"/>
                <field name="property_project_id" readonly="1"
                       invisible="not property_project_id"/>
                <field name="property_id" readonly="1"
                       invisible="not property_id"/>
            </xpath>
        </field>
    </record>
</odoo>
