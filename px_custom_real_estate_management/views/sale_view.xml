<odoo>
    <record id="view_order_form_inherit_installments" model="ir.ui.view">
        <field name="name">sale.order.form.installments</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_installment_invoices"
                        type="object"
                        class="oe_stat_button"
                        invisible="payment_id"
                        icon="fa-dollar">
                    <field name="installment_count" widget="statinfo" string="Installment Invoices"/>
                </button>
                <button name="action_view_so_installment_invoices_so"
                        type="object"
                        class="oe_stat_button"
                        invisible="not payment_id"
                        icon="fa-dollar">
                    <field name="so_installment_invoice_count" widget="statinfo" string="Installment Invoices"/>
                </button>
            </xpath>
            <header position="inside">
                <button name="action_generate_installments"
                        string="Generate Installments"
                        type="object"
                        class="btn-secondary"
                        invisible="not payment_id" />
                <button name="action_create_installment_invoices"
                        string="Create Installment Invoices"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'sale' or payment_id or installment_invoice_created" />
                <button name="action_create_installment_invoices_from_so"
                    type="object"
                    string="Create Installment Invoices"
                    class="btn-primary"
                    invisible="not installment_line_ids or installment_invoice_created" />
            </header>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="property_id"/>
                <field name="payment_id" domain="[('state', '=', 'published')]"/>
                <field name="installment_start_date" invisible="not payment_id"/>
                <field name="pay_with_cheque" invisible="not payment_id"/>
                <field name="cheque_number_start" invisible="not payment_id or not pay_with_cheque"/>
<!--                <field name="maintenance_date"/>-->
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Installments" invisible="not payment_id">
                    <group>
                        <group>
                            <field name="installment_round_step"/>
                            <field name="installment_round_direction"/>
                        </group>
                        <group>
                            <field name="installment_total_target" readonly="1"/>
                            <field name="installment_difference" readonly="1"/>
                            <div class="o_row">
                                <button name="action_round_installments"
                                        string="Round"
                                        type="object"
                                        class="btn-secondary"/>
                                <button name="action_rebalance_installments"
                                        string="Rebalance"
                                        type="object"
                                        class="btn-secondary"/>
                            </div>
                        </group>
                    </group>
                    <field name="installment_line_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="line_type"/>
                            <field name="capital_repayment"/>
                            <field name="amount_after_tax"/>
                            <field name="remaining_capital"/>
                            <field name="collection_status"/>
                            <field name="collection_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>