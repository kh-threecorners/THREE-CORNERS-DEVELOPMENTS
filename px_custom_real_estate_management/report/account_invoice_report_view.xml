<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_report_search_property" model="ir.ui.view">
        <field name="name">account.invoice.report.search.property</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_order_id"/>
                <field name="property_project_id"/>
                <field name="property_id"/>
                <field name="installment_type"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Sale Order" name="group_by_sale_order"
                        context="{'group_by': 'sale_order_id'}"/>
                <filter string="Project" name="group_by_property_project"
                        context="{'group_by': 'property_project_id'}"/>
                <filter string="Unit" name="group_by_property"
                        context="{'group_by': 'property_id'}"/>
                <filter string="Installment Type" name="group_by_installment_type"
                        context="{'group_by': 'installment_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
