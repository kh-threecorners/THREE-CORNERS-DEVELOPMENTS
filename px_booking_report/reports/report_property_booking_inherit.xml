<odoo>
    <!-- The booking report was edited in Studio on the database, so changes to it
         go through this inherited view instead of the template file. -->
    <template id="report_property_sale_document_custom"
              inherit_id="px_booking_report.report_property_sale_document">
        <xpath expr="//span[@t-field='o.property_type']" position="attributes">
            <attribute name="t-field">o.unit_type_id</attribute>
        </xpath>
        <xpath expr="//h3[contains(., 'التوقيعات')]/.." position="attributes">
            <attribute name="class" add="tc-signatures" separator=" "/>
        </xpath>
        <xpath expr="//h3[contains(., 'التوقيعات')]" position="before">
            <style type="text/css">
                .tc-signatures { margin-top: 8px !important; page-break-inside: avoid; }
                .tc-signatures .row { padding: 6px 0 !important; }
                .tc-signatures .row > div { min-height: 0 !important; }
                .tc-signatures .row > div p:last-child { margin-top: 36px !important; }
            </style>
        </xpath>
    </template>
</odoo>
